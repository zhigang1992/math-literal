{
  "name": "math-literal",
  "version": "0.2.0",
  "license": "MIT",
  "author": "Kyle Fang",
  "main": "dist/index.js",
  "module": "dist/math-literal.esm.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "analyze": "size-limit --why",
    "build": "bun run build:esm && bun run build:cjs && bun run build:types",
    "build:esm": "bun build src/index.ts --outdir dist --format esm --packages external --sourcemap --entry-naming math-literal.esm.js",
    "build:cjs": "bun build src/index.ts --outdir dist --format cjs --packages external --sourcemap --entry-naming index.js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "size": "size-limit",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run build"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "engines": {
    "node": ">=22"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "18 KB"
    },
    {
      "path": "dist/math-literal.esm.js",
      "limit": "18 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@tsconfig/recommended": "^1.0.7",
    "@types/node": "^22.7.9",
    "husky": "^9.1.6",
    "prettier": "^2.8.8",
    "size-limit": "^11.1.6",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  }
}
